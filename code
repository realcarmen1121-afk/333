def get_drug_info(drug_name):
    """根據藥物名稱獲取藥物資訊，不分大小寫"""
    for key, value in DRUG_DATABASE.items():
        if key.lower() == drug_name.lower():
            return key, value
    return None, None

def get_all_drugs():
    """獲取所有可用的藥物清單"""
    return list(DRUG_DATABASE.keys())
